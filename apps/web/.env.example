# Wagr api origin the browser talks to (BFF — the web never calls Supabase
# or Moolre directly).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Canonical public origin of the deployed site. Used as metadataBase so
# OG/Twitter share images resolve to absolute URLs. Set to the production
# URL in Vercel; safe to omit locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
